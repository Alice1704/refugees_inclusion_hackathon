{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UNHCR output Record",
  "type": "object",
  "required": [
    "record_id",
    "interview",
    "household",
    "demographics",
    "needs_and_coping",
    "scores",
    "administrative_flags",
    "decision",
    "analysis"
  ],
  "properties": {

    "record_id": {
      "type": "integer"
    },

    "interview": {
      "type": "object",
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "office": {
          "type": ["string", "null"]
        }
      }
    },

    "household": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer"
        },
        "dependency_category": {
          "type": "string",
          "enum": ["low", "average", "complete", "high"]
        },
        "female_headed": {
          "type": ["boolean", "null"]
        },
        "sole_carer": {
          "type": ["boolean", "null"]
        },
        "spanish_spoken": {
          "type": "boolean"
        },
        "adult_illiteracy": {
          "type": "boolean"
        }
      }
    },

    "demographics": {
      "type": "object",
      "properties": {
        "head_of_household": {
          "type": "number"
        },
        "language_barrier": {
          "type": "number"
        },
        "specific_needs": {
          "type": "number"
        },
        "documentation": {
          "type": "number"
        },
        "score": {
          "type": "number"
        }
      }
    },

    "needs_and_coping": {
      "type": "object",
      "properties": {
        "basic_needs": {
          "type": "number"
        },
        "housing": {
          "type": "number"
        },
        "negative_coping": {
          "type": "number"
        },
        "dependency": {
          "type": "number"
        },
        "score": {
          "type": "number"
        }
      }
    },

    "scores": {
      "type": "object",
      "properties": {
        "final_score": {
          "type": "number"
        },
        "vulnerability_index": {
          "type": "number"
        },
        "vulnerability_category": {
          "type": "string",
          "enum": [
            "Vulnerabilidad Baja",
            "Vulnerabilidad Moderada",
            "Vulnerabilidad Elevada",
            "Vulnerabilidad Severa"
          ]
        }
      }
    },

    "administrative_flags": {
      "type": "object",
      "properties": {
        "asylum_procedure": {
          "type": ["integer", "null"]
        },
        "intentions": {
          "type": "integer"
        },
        "duplicate": {
          "type": "integer"
        }
      }
    },

    "decision": {
      "type": "object",
      "properties": {
        "eligibility_target": {
          "type": "string",
          "enum": ["INCLUSION", "EXCLUSION"]
        },
        "eligibility_status": {
          "type": "string",
          "enum": [
            "Elegible",
            "Elegible por Proceso Acelerado",
            "Lista de Reserva",
            "No Elegible",
            "No Elegible por Intenciones",
            "No Elegible por Duplicidad"
          ]
        }
      }
    },

    "analysis": {
      "type": "string"
    }
  }
}
